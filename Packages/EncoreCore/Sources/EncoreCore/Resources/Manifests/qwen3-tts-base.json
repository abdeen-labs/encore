  "parameters": [
    {
      "key": "temperature",
      "label": "Variation",
      "type": "float",
      "tier": "basic",
      "help": "Higher sounds livelier and less predictable; lower sounds steadier. Too high can garble words.",
      "min": 0.1,
      "max": 1.5,
      "step": 0.05,
      "default": 0.9
    },
    {
      "key": "top_k",
      "label": "Top-k",
      "type": "int",
      "tier": "advanced",
      "help": "Only the k most likely sound tokens are considered at each step. Lower is safer, higher more varied.",
      "min": 1,
      "max": 200,
      "step": 1,
      "default": 50
    },
    {
      "key": "top_p",
      "label": "Top-p",
      "type": "float",
      "tier": "advanced",
      "help": "Only tokens within this share of probability are considered. 1 turns the filter off.",
      "min": 0.1,
      "max": 1.0,
      "step": 0.05,
      "default": 1.0
    },
    {
      "key": "repetition_penalty",
      "label": "Repetition penalty",
      "type": "float",
      "tier": "advanced",
      "help": "Discourages the model from looping on the same sounds. Raise it slightly if output stutters or repeats.",
      "min": 1.0,
      "max": 2.0,
      "step": 0.01,
      "default": 1.05
    },
    {
      "key": "max_tokens",
      "label": "Length limit",
      "type": "int",
      "tier": "advanced",
      "help": "Hard cap on generated audio, in tokens of 1/12.5 s (4096 ≈ 5.5 minutes). The model also caps it by text length.",
      "min": 75,
      "max": 8192,
      "step": 1,
      "unit": "tokens",
      "default": 4096
    },
    {
      "key": "seed",
      "label": "Seed",
      "type": "seed",
      "tier": "advanced",
      "help": "Fix this to get the same take again from the same settings. Leave empty for a fresh take each time."
    }
  ],
  "reference": {
    "minSeconds": 3,
    "maxSeconds": 15,
    "transcript": "recommended"
