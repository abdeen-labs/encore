{
  "id": "chatterbox-multilingual",
  "name": "Chatterbox Multilingual",
  "family": "Chatterbox",
  "summary": "Resemble AI's voice cloner for 23 languages, with an emotion-intensity control. Clones from a short clip; no transcript needed. Runs in the Python helper.",
  "tasks": [
    "tts"
  ],
  "engine": "chatterbox",
  "variants": [
    {
      "id": "v3",
      "label": "Multilingual v3",
      "repo": "mlx-community/chatterbox-multilingual-v3",
      "companionRepos": [
        "mlx-community/S3TokenizerV2"
      ],
      "allowPatterns": [
        "*.json",
        "*.safetensors"
      ],
      "companionAllowPatterns": {
        "mlx-community/S3TokenizerV2": [
          "model.safetensors",
          "config.json"
        ]
      },
      "downloadBytes": 3207973708,
      "memoryBytes": 5000000000,
      "recommended": true
    }
  ],
  "license": {
